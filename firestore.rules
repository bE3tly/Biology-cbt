rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidScore(data) {
      return data.userName is string && data.userName.size() <= 100 &&
             data.score is number && data.score >= 0 &&
             data.date is string &&
             data.timeToFinish is number;
    }
    function isValidUser(data) {
        return data.name is string && data.email is string && data.registrationDate is string;
    }
    function isValidResult(data) {
        return data.userId is string && data.userName is string && data.score is number && data.date is string && data.timeToFinish is number;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /scores/{scoreId} {
      allow list: if true;
      allow create: if isValidScore(request.resource.data) && isValidId(scoreId);
      allow read: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isAdmin();
      allow create: if isValidUser(request.resource.data) && isValidId(userId);
    }
    
    match /test_results/{resultId} {
      allow list: if true;
      allow read: if isAdmin();
      allow create: if isValidResult(request.resource.data) && isValidId(resultId);
    }
    
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }
  }
}

